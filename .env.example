# Backend API base URL (no /api suffix: routes are served at the root).
EXPO_PUBLIC_API_URL=https://api.domilix.com

# Geoapify geocoding key ("Utiliser ma position" and address autocomplete on
# step 3 of listing creation). Get one at https://myprojects.geoapify.com.
# In CI it comes from the repository secret EXPO_PUBLIC_GEOAPIFY_API_KEY.
EXPO_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-api-key

# Set to 1 to expose the hidden component catalogue (QA builds only): a row at
# the bottom of Settings and the deep link domilix://dev/catalogue. Leave empty
# otherwise: the route then redirects to the home screen.
EXPO_PUBLIC_SHOW_CATALOGUE=
