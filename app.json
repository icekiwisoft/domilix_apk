{
  "expo": {
    "name": "domilix",
    "slug": "domilix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "domilix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jack0237.domilix",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/houses/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/furnitures/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/terrains/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/fr/houses/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/fr/furnitures/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/fr/terrains/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/en/houses/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/en/furnitures/"
            },
            {
              "scheme": "https",
              "host": "domilix.com",
              "pathPrefix": "/en/terrains/"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-optional-portrait",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@thoughtbot/react-native-social-auth",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Domilix a besoin de votre position pour pré-remplir la ville et l'adresse de votre annonce.",
          "locationAlwaysAndWhenInUsePermission": "Domilix a besoin de votre position pour pré-remplir la ville et l'adresse de votre annonce."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#e8921a",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61d665b4-02dd-49b0-9f8e-912837bcac18"
      }
    }
  }
}
